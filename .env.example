# Copy to .env and fill in the secrets. Never commit .env.
# This template is committed: leave every secret EMPTY here.

# Local model server (oMLX, OpenAI-compatible)
LLM_BASE_URL=http://127.0.0.1:8888/v1
LLM_BASE_URL_DOCKER=http://host.docker.internal:8888/v1
LLM_API_KEY=
LLM_MODEL=Qwen3.5-9B-OptiQ-4bit

# Judge and guard (must not be a Qwen model). Both run on the local oMLX server (docs/13 §1b).
JUDGE_PROVIDER=local
JUDGE_MODEL=gemma-4-e2b-it-OptiQ-4bit
GUARD_PROVIDER=local
GUARD_MODEL=Llama-Guard-3-1B-chat-mlx-4bit
GUARD_MODE=completions_raw
GUARD_PROMPT_TEMPLATE=prompts/guard_llama_guard_3.txt
# Hosted alternative (needs OPENROUTER_API_KEY):
# JUDGE_PROVIDER=openrouter
# JUDGE_MODEL=google/gemini-3.1-flash-lite
# GUARD_PROVIDER=openrouter
# GUARD_MODEL=meta-llama/llama-guard-4-12b
# GUARD_MODE=chat
# GUARD_PROMPT_TEMPLATE=
OPENROUTER_API_KEY=

# Databases (local Postgres; create roles and databases with scripts/db_bootstrap.sh)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auditguard
POSTGRES_USER=auditguard
POSTGRES_PASSWORD=
GROUNDTRUTH_DB=groundtruth
GROUNDTRUTH_USER=groundtruth
GROUNDTRUTH_PASSWORD=
# Read-only role for the transactions and aml_engine MCP servers (SELECT on ledger.* only)
LEDGER_RO_USER=auditguard_ro
LEDGER_RO_PASSWORD=
# LangGraph checkpoints: postgres (app database, schema `checkpoint`) or sqlite (CHECKPOINT_DB)
CHECKPOINTER=postgres
CHECKPOINT_DB=var/checkpoints.db
# Approval records: postgres (app database, schema `approval`) or sqlite (APPROVAL_STORE)
APPROVAL_BACKEND=postgres
APPROVAL_STORE=var/approvals.db
# Tool-call audit log: postgres (app database, schema `audit`), memory or none
AUDIT_BACKEND=postgres
# Pseudonymisation before any model call: token key (secret) and the encrypted vault
PSEUDONYM_KEY=
PSEUDONYM_VAULT=postgres

# Postgres superuser, used only by scripts/db_bootstrap.sh (leave the password empty to be prompted)
PGADMIN_USER=postgres
PGADMIN_PASSWORD=postgress

# Vector store
QDRANT_URL=http://localhost:6333

# Approval HMAC key (any long random string)
APPROVAL_HMAC_KEY=
# MCP agent-token HMAC key (any long random string, different from the approval key)
MCP_TOKEN_KEY=

# Evaluation: path to held-out cases OUTSIDE the repo (role 1 only)
HELDOUT_DIR=

# Tracing (docs/11 §7). Default backend langsmith: live runs need LANGSMITH_API_KEY.
# TRACING_BACKEND=none is for offline unit work only; run-case, eval and llm-check refuse it.
TRACING_BACKEND=
TRACING_PROJECT=
# Region of your LangSmith account: US (default) https://api.smith.langchain.com,
# EU https://eu.api.smith.langchain.com, APAC https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=      # only if the key is organisation-scoped (LangSmith returns 403 without it)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGSMITH_API_KEY=

# Retrieval switches (docs/07; one E5 staircase step each) and the local model cache
RETRIEVAL_BM25=true
RETRIEVAL_VECTOR=true
RETRIEVAL_RERANK=true
RETRIEVAL_DECOMPOSE=true
MODEL_CACHE=var/models
